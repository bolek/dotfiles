#!/bin/sh
#
# dot
#
# `dot` handles installation, updates, things like that. Run it periodically
# to make sure you're on the latest and greatest. macOS defaults are applied
# once by script/bootstrap (or by hand with `set-defaults`), not here.
export ZSH=$HOME/.dotfiles

# Install homebrew
$ZSH/homebrew/install.sh 2>&1
[ -x /opt/homebrew/bin/brew ] && eval "$(/opt/homebrew/bin/brew shellenv)"

# Upgrade homebrew
echo "› brew update"
brew update

# Install software
echo "› $ZSH/script/install"
$ZSH/script/install

# Tidy up old versions and downloads
echo "› brew cleanup"
brew cleanup

# Report anything installed that no Brewfile lists (dry run; nothing removed)
# shellcheck disable=SC1090
[ -f ~/.localrc ] && . ~/.localrc
all=$(mktemp)
cat "$ZSH/Brewfile" "$ZSH/profiles/${DOTFILES_PROFILE:-none}/Brewfile" 2>/dev/null > "$all"
echo "› not in any Brewfile (remove with: brew bundle cleanup --force --file=<list>)"
brew bundle cleanup --file="$all" || true
rm -f "$all"

# Identity, signing and anything machine/profile specific go in the include
# (generated by script/bootstrap from gitconfig.local.symlink.example).
[include]
        path = ~/.gitconfig.local
[alias]
        co = checkout
        promote = !$ZSH/bin/git-promote
        count   = !git shortlog -sn
[color]
        ui = auto
[core]
        excludesfile = ~/.gitignore
        editor = vim
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        default = simple
[rebase]
        autosquash = true
[gpg]
        program = gpg2
[credential "https://github.com"]
        helper =
        helper = !gh auth git-credential
[credential "https://gist.github.com"]
        helper =
        helper = !gh auth git-credential
